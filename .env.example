# ---------- Qdrant Cloud (free tier) ----------
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_textbook

# ---------- Embeddings (local, free) ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ---------- Ingestion ----------
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# ---------- Retrieval ----------
CANDIDATES_PER_RETRIEVER=20
CONTEXT_CHUNKS=5
RRF_K=60
# Evidence gate: if the best dense cosine score is below this, the bot refuses to answer.
# Calibrate with GET /api/v1/admin/retrieve?q=... (see README).
MIN_DENSE_SCORE=0.45

# ---------- LLM router ----------
# Ordered failover chain "provider:model,provider:model". Providers: groq, gemini, ollama, mock.
# Using two models per provider is a cheap way to get separate free-tier quotas.
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.8-flash,ollama:llama3.1:8b
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=900
# Estimated prompt size cap. Oldest history, then the lowest-ranked passages, are dropped to fit.
# Groq free tier: llama-3.1-8b-instant allows only 6,000 tokens/minute (input + output).
LLM_MAX_INPUT_TOKENS=4500
LLM_FIRST_TOKEN_TIMEOUT_S=20
LLM_STALL_TIMEOUT_S=30
LLM_CONNECT_TIMEOUT_S=10
# Tokens are held back until this many characters have arrived, so a provider that fails
# early can be swapped out without the user ever seeing a half answer.
STREAM_COMMIT_CHARS=120

# ---------- API ----------
# Leave empty to disable /api/v1/admin/* entirely. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
MAX_HISTORY_MESSAGES=4
LOG_LEVEL=INFO
LOG_JSON=true

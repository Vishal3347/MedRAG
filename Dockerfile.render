# Slim image for free hosts with ~512 MB RAM (Render). Query-time only: ingestion runs on your own machine.
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MALLOC_ARENA_MAX=2 \
    EMBEDDING_BACKEND=fastembed FASTEMBED_CACHE_DIR=/models
WORKDIR /srv

COPY requirements-render.txt .
RUN pip install -r requirements-render.txt

# Bake the ONNX embedding model into the image so a cold start does not download it.
ARG EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RUN mkdir -p /models && python -c "from fastembed import TextEmbedding; TextEmbedding('${EMBEDDING_MODEL}', cache_dir='/models')"

COPY app ./app
RUN useradd -m app && chown -R app /srv /models
USER app
EXPOSE 10000
# Render injects $PORT (10000 by default). One worker only: every extra worker loads its own model copy.
CMD ["sh", "-c", "uvicorn app.api.main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
